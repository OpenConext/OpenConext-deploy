#!/bin/bash
# Script to remove logins that are older than LOG_LOGINS_MAX_AGE months from the log_logins table
# in the ${DB_LOG_LOGINS_NAME} database on the ${DB_LOG_LOGINS_HOST} host
# As a failsafe, the script will refuse to run in one go if more than ${MAX_DELETE_DAYS} days worth of logins would be removed.
# While ${MAX_DELETE_DAYS} is higher then allowed a loop will run which will delete the DB entries for the last day alone.
# The loop will stop and exit after removing 10 days as a failsafe for not removing to much.
# Once the loop has removed enough that the ${MAX_DELETE_DAYS} value is not exceeded the script will run trough normally.
# If you wish to force the script to run ignoring the ${MAX_DELETE_DAYS} you can provide the --force option.
# Using this option is not advised as this can take a long time and will use more storage on the DB.
# This can fill up the DB disk and crash the DB as a result.
# The script is intended to be run daily from a cron job.

MAX_DELETE_DAYS=5
LOG_LOGINS_MAX_AGE="{{ loglogins_max_age }}" # Number of MONTHS of logins to keep
RSYSLOG_DIR="{{ rsyslog_dir }}"
RSYSLOG_ENVIRONMENT_NAME="{{ rsyslog_environment.name }}"
DB_LOG_LOGINS_NAME="{{ rsyslog_environment.db_loglogins_name }}"
DB_LOG_LOGINS_USER="{{ rsyslog_environment.db_loglogins_user }}"
DB_LOG_LOGINS_PASSWORD="{{ rsyslog_environment.db_loglogins_password }}"
DB_LOG_LOGINS_HOST="{{ rsyslog_environment.db_loglogins_host }}"
NOREPLY_EMAIL="{{ noreply_email }}"
ERROR_MAIL_TO="{{ error_mail_to }}"
ANSIBLE_HOSTNAME="{{ ansible_hostname }}"

LOG_FILE="${RSYSLOG_DIR}/apps/${RSYSLOG_ENVIRONMENT_NAME}/loglogins_cleanup/loglogins_cleanup.log"
FORCE=0 # Whether to run if more than ${MAX_DELETE_DAYS} days of log data would be removed.

SCRIPT_NAME=$0

for ARG in "$@"; do
  case "$ARG" in
    --force)
      FORCE=1
      ;;
    *)
      echo "Usage: $0 [--force]"
      exit 1
      ;;
  esac
done

log_message() {
  echo "$(date '+%h %d %H:%M:%S')" "$@" | tee -a "$LOG_FILE"
}

send_mail() {
  local message="$*"

  log_message "Mailing error to ${ERROR_MAIL_TO}"

  echo "$message" | mail \
    -r "${NOREPLY_EMAIL}" \
    -s "log_login script on ${ANSIBLE_HOSTNAME} for environment ${RSYSLOG_ENVIRONEMTN_NAME} has failed." \
    "${ERROR_MAIL_TO}"
}

log_message "Starting cleanup of old log_logins data"

LOGIN_STAMP=$(date -d "-${LOG_LOGINS_MAX_AGE} months" +%Y-%m-%d)
log_message "Removing all logins older than ${LOG_LOGINS_MAX_AGE} months (before ${LOGIN_STAMP})"

log_message "Using database: ${DB_LOG_LOGINS_USER}@${DB_LOG_LOGINS_HOST}:${DB_LOG_LOGINS_NAME}"

MYSQL_DB=(
  "mysql"
  "-u" "${DB_LOG_LOGINS_USER}"
  "-p${DB_LOG_LOGINS_PASSWORD}"
  "-h" "${DB_LOG_LOGINS_HOST}"
)

# Find the oldest timestamp in the log_logins table:
#   SELECT (DATE_FORMAT(loginstamp,'%Y-%m-%d')) FROM log_logins ORDER BY loginstamp ASC LIMIT 1
QUERY=(
  "${MYSQL_DB[@]}"
  # -s: silent; -e: query
  "-se" "SELECT (DATE_FORMAT(loginstamp,'%Y-%m-%d')) FROM log_logins ORDER BY loginstamp ASC LIMIT 1"
  "${DB_LOG_LOGINS_NAME}"
)
# DEBUG: Print query
# echo "${QUERY[@]}"
if ! OLDEST_TIMESTAMP=$( "${QUERY[@]}" ); then
  QUERY_FAIL=$("${QUERY[@]}" 2>&1)
  log_message "Error running mysql query, was trying to read from the database. The following error occured: $QUERY_FAIL"
  send_mail "Error running mysql query, was trying to read from the database. The following error occured: $QUERY_FAIL"
  exit 1
fi
if [ -z "$OLDEST_TIMESTAMP" ]; then
  log_message "No logins found in log_logins. Nothing to cleanup."
  # The log_logins table is empty. Not treating this as an error. Exit normally,
  exit 0
fi

# If we are going to delete more than ${MAX_DELETE_DAYS} days, something might be wrong
# Warn and exit if this is the case, unless FORCE==1
LOGIN_STAMP_UNIX=$(date -d "$LOGIN_STAMP" +%s)
OLDEST_TIMESTAMP_UNIX=$(date -d "$OLDEST_TIMESTAMP" +%s)
TIMESTAMP_DIFF=$(( (LOGIN_STAMP_UNIX-OLDEST_TIMESTAMP_UNIX)/3600/24 ))
log_message "The oldest timestamp in the database is $OLDEST_TIMESTAMP"
if [ "$TIMESTAMP_DIFF" -lt "0" ]; then
  log_message "There is no data to delete. We're done."
  exit 0
fi

log_message "We will delete $TIMESTAMP_DIFF days of log_logins data, the oldest data is from $OLDEST_TIMESTAMP"

# Checking if there is to much data to be removed at once. If so a loop will run which will cleanup the last day of data running up to 10 times or until ${MAX_DELETE_DAYS} is reached.
DELETE_COUNT=0
while [ "$TIMESTAMP_DIFF" -gt "$MAX_DELETE_DAYS" ] && [ "$FORCE" -ne 1 ] && [ $DELETE_COUNT -le 10 ]; do
  log_message "The cleanup loop is running because there is to much data. Cleaning up data for: $OLDEST_TIMESTAMP"
  QUERY_DELETE=("${MYSQL_DB[@]}" "-sNe" "DELETE FROM log_logins WHERE loginstamp LIKE '${OLDEST_TIMESTAMP}%'; SELECT row_count();" "${DB_LOG_LOGINS_NAME}")
  if ! DELETED_ROWS=$( "${QUERY_DELETE[@]}" ); then
    QUERY_FAIL=$("${QUERY_DELETE[@]}" 2>&1)
    log_message "Error running mysql query, was trying to delete from the database within the loop. The following error occured: $QUERY_FAIL"
    send_mail "Error running mysql query, was trying to delete from the database within the loop. The following error occured: $QUERY_FAIL"
    exit 1
  fi
  log_message "Cleaning up data in a loop for the date: $OLDEST_TIMESTAMP succeeded, deleted $DELETED_ROWS rows."
  QUERY_READ=("${MYSQL_DB[@]}" "-se" "SELECT (DATE_FORMAT(loginstamp,'%Y-%m-%d')) FROM log_logins ORDER BY loginstamp ASC LIMIT 1" "${DB_LOG_LOGINS_NAME}")
  if ! OLDEST_TIMESTAMP=$( "${QUERY_READ[@]}" ); then
    QUERY_FAIL=$("${QUERY_READ[@]}" 2>&1)
    log_message "Error running mysql query, was trying to read from the database within the loop. The following error occured: $QUERY_FAIL"
    send_mail "Error running mysql query, was trying to read from the database within the loop. The following error occured: $QUERY_FAIL"
    exit 1
  fi
  OLDEST_TIMESTAMP_UNIX=$(date -d "$OLDEST_TIMESTAMP" +%s)
  TIMESTAMP_DIFF=$(( (LOGIN_STAMP_UNIX-OLDEST_TIMESTAMP_UNIX)/3600/24 ))
  ((DELETE_COUNT++))
done

# Log and/or e-mail what happend in the loop, if it ran.
if [ "$DELETE_COUNT" -gt 0 ] && [ "$DELETE_COUNT" -lt 10 ]; then
  log_message "Ran a loop to cleanup data older then is allowed to be removed in one command. No further action is required if this message only appears once."
  send_mail "Ran a loop to cleanup data older then is allowed to be removed in one command. No further action is required if this message only appears once."
elif [ "$DELETE_COUNT" -ge 10 ]; then
  log_message "Ran a loop to cleanup data older then is allowed to be removed in one command. There is so much data that this cannot be done at once. Admin intervention is required to solve this issue manually if this message appears multiple times. The oldest data in the database is from $OLDEST_TIMESTAMP"
  send_mail "Ran a loop to cleanup data older then is allowed to be removed in one command. There is so much data that this cannot be done at once. Admin intervention is required to solve this issue manually if this message appears multiple times. The oldest data in the database is from $OLDEST_TIMESTAMP"
fi

# Log if force option is ran.
if [ "$TIMESTAMP_DIFF" -gt "$MAX_DELETE_DAYS" ] && [ "$FORCE" -eq 1 ]; then
  log_message "Force option provided; deleting more than ${MAX_DELETE_DAYS} days worth of login data in one go."
fi

# Delete rows
QUERY=(
  "${MYSQL_DB[@]}"
  # -s: silent; -N: Don't write column names in results; -e: query;
  "-sNe" "DELETE FROM log_logins WHERE loginstamp < '${LOGIN_STAMP}'; SELECT row_count();"
  "${DB_LOG_LOGINS_NAME}"
)
# DEBUG: Print query
# echo "${QUERY[@]}"
if ! DELETED_ROWS=$( "${QUERY[@]}" ); then
  QUERY_FAIL=$("${QUERY[@]}" 2>&1)
  log_message "Error running mysql query, was trying to delete rows from the database. The following error occured: $QUERY_FAIL"
  send_mail "Error running mysql query, was trying to delete rows from the database. The following error occured: $QUERY_FAIL"
  exit 1
fi

log_message "We have deleted $DELETED_ROWS rows. Done."
